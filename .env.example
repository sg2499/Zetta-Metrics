# Copy this file to .env.local for local development, and set the same
# variables in your Vercel project settings for production.

# API key from https://resend.com — used to send Contact form submissions
# by email (no database involved).
RESEND_API_KEY=

# Optional. The "from" address Resend sends as — must be on a domain you've
# verified with Resend (e.g. "Zetta Metrics <noreply@zetta-metrics.com>").
# If unset, falls back to Resend's shared sandbox sender (onboarding@resend.dev),
# which works but is less reliable for inbox delivery long-term.
CONTACT_FROM_EMAIL=
